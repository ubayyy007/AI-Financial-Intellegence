# ─── Google Gemini API ─────────────────────────────────────────────────────────
# Required only for PDF parsing. Get a free key at: https://aistudio.google.com/apikey
# If not set here, users can enter the key manually via the in-app settings panel.
VITE_GEMINI_API_KEY=

# Gemini model to use for document parsing.
# Update this if the model is deprecated — check: https://ai.google.dev/gemini-api/docs/models
VITE_GEMINI_MODEL=gemini-2.5-flash
