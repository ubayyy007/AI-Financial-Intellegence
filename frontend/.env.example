# ─── Google Gemini API ─────────────────────────────────────────────────────────
# Get a free key at: https://aistudio.google.com/apikey

# ── For Vercel deployment (server-side, RECOMMENDED) ──────────────────────────
# Set these in the Vercel dashboard → Project → Settings → Environment Variables.
# The key stays on the server — visitors never see it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── For local development only (optional) ─────────────────────────────────────
# If not set here, developers can enter the key manually via the in-app settings panel.
# VITE_GEMINI_API_KEY=
# VITE_GEMINI_MODEL=gemini-2.5-flash
